{
  "name": "infinishoot",
  "private": true,
  "version": "1.6.0",
  "description": "A colorful twin-stick survivors-style roguelike",
  "author": "Mansour Almadi",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "smoke": "node scripts/run-tests.mjs smoke",
    "shot": "node scripts/shot.mjs",
    "coop": "node scripts/coop-test.mjs",
    "coop8": "node scripts/coop8.mjs",
    "voicechat": "node scripts/voicechat-test.mjs",
    "bench": "node scripts/bench.mjs",
    "replay": "node scripts/replay.mjs",
    "visual": "node scripts/visual.mjs",
    "balance": "node scripts/replay.mjs --balance",
    "loadtime": "node scripts/loadtime.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "soak": "node scripts/soak.mjs",
    "icons": "node scripts/icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable --publish never -c.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.mansouralmadi.infinishoot",
    "productName": "InfiniShoot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "InfiniShoot.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "InfiniShoot uses the microphone for voice chat with your co-op teammates (only when VOICE CHAT is turned on)."
      }
    },
    "dmg": {
      "artifactName": "InfiniShoot-mac-${arch}.dmg"
    }
  },
  "devDependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@types/three": "^0.186.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "lil-gui": "^0.21.0",
    "peerjs": "^1.5.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.9",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
